{
  "$schema": "sources.schema.json",
  "version": 1,
  "notes": [
    "本文件是唯一的项目清单与资产匹配规则来源，增删仓库只需改这里。",
    "repo 必须逐一人工核实为作者官方仓库；不要凭记忆填写。",
    "rules 按顺序匹配文件名（完整 basename），命中第一条即停止；arch 可用 $捕获组 引用命名分组。",
    "exclude 在 rules 之前生效，用于排除签名、校验文件、源码包、Linux 包等。",
    "license.redistribution：allowed=允许原样再分发；official-only=仅提供官方入口，不上传本站存储。",
    "mirror.enabled=false 时，即使许可证允许，本站也不会同步/提供该项目的文件。"
  ],
  "sources": [
    {
      "id": "clash-verge-rev",
      "name": "Clash Verge Rev",
      "nameZh": "Clash Verge Rev",
      "summary": "基于 Tauri 的 Mihomo（Clash Meta）图形客户端，支持订阅、规则与系统代理。",
      "repo": "clash-verge-rev/clash-verge-rev",
      "homepage": "https://clash-verge-rev.github.io/",
      "platforms": ["windows", "macos"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接；本站不修改安装包。"
      },
      "mirror": { "enabled": true, "note": "" },
      "exclude": [
        "\\.sig$",
        "\\.json$",
        "\\.tar\\.gz$",
        "\\.deb$",
        "\\.rpm$",
        "\\.AppImage$",
        "armhf",
        "armhfp"
      ],
      "rules": [
        {
          "match": "^Clash\\.Verge_[0-9.]+_(?<arch>x64|arm64)_fixed_webview2-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "fixed-webview2",
          "arch": "$arch"
        },
        {
          "match": "^Clash\\.Verge_[0-9.]+_(?<arch>x64|arm64)-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^Clash\\.Verge_[0-9.]+_(?<arch>x64|aarch64)\\.dmg$",
          "platform": "macos",
          "format": "dmg",
          "variant": "installer",
          "arch": "$arch"
        }
      ],
      "caveats": ["Windows 提供标准版与固定 WebView2 版本；后者用于系统 WebView2 异常的环境。"]
    },
    {
      "id": "clash-party",
      "name": "Clash Party",
      "nameZh": "Clash Party（原 Mihomo Party）",
      "summary": "Mihomo 内核的跨平台图形客户端，仓库由 mihomo-party 更名为 clash-party。",
      "repo": "mihomo-party-org/clash-party",
      "homepage": "https://clash-party.org/",
      "platforms": ["windows", "macos"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接。"
      },
      "mirror": { "enabled": true, "note": "" },
      "exclude": [
        "\\.sha256$",
        "linux-",
        "catalina-",
        "win7-",
        "ia32",
        "\\.deb$",
        "\\.rpm$",
        "\\.zst$"
      ],
      "rules": [
        {
          "match": "^clash-party-windows-[0-9.]+-(?<arch>x64|arm64)-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^clash-party-windows-[0-9.]+-(?<arch>x64|arm64)-portable\\.7z$",
          "platform": "windows",
          "format": "7z",
          "variant": "portable",
          "arch": "$arch"
        },
        {
          "match": "^clash-party-macos-[0-9.]+-(?<arch>arm64|x64)\\.pkg$",
          "platform": "macos",
          "format": "pkg",
          "variant": "installer",
          "arch": "$arch"
        }
      ],
      "caveats": [
        "项目仓库已从 mihomo-party-org/mihomo-party 更名为 mihomo-party-org/clash-party，本配置使用新地址。",
        "便携版为 7z 压缩包，需用 7-Zip 等工具解压。"
      ]
    },
    {
      "id": "flclash",
      "name": "FlClash",
      "nameZh": "FlClash",
      "summary": "Flutter 编写的 Mihomo 图形客户端，同时提供 Windows、macOS、Android 版本。",
      "repo": "chen08209/FlClash",
      "homepage": "https://github.com/chen08209/FlClash",
      "platforms": ["windows", "macos", "android"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接。"
      },
      "mirror": { "enabled": true, "note": "" },
      "checksum": { "type": "sumfile", "file": "SHA256SUMS" },
      "exclude": ["^SHA256SUMS$", "linux-"],
      "rules": [
        {
          "match": "^FlClash-[0-9.]+-windows-(?<arch>amd64|arm64)-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^FlClash-[0-9.]+-windows-(?<arch>amd64|arm64)\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "portable",
          "arch": "$arch"
        },
        {
          "match": "^FlClash-[0-9.]+-macos-(?<arch>arm64|amd64)\\.dmg$",
          "platform": "macos",
          "format": "dmg",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^FlClash-[0-9.]+-android-(?<arch>arm64-v8a|armeabi-v7a|x86_64)\\.apk$",
          "platform": "android",
          "format": "apk",
          "variant": "default",
          "arch": "$arch"
        }
      ],
      "caveats": ["发布页附带 SHA256SUMS，本站会用它核对下载文件。"]
    },
    {
      "id": "clash-nyanpasu",
      "name": "Clash Nyanpasu",
      "nameZh": "Clash Nyanpasu",
      "summary": "Mihomo 内核的桌面客户端，支持多配置、规则编辑与托盘切换。",
      "repo": "LibNyanpasu/clash-nyanpasu",
      "homepage": "https://github.com/LibNyanpasu/clash-nyanpasu",
