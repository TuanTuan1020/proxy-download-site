    {
      "id": "sing-box",
      "name": "sing-box",
      "nameZh": "sing-box（SFA / SFM / SFW）",
      "summary": "sing-box 官方图形客户端：Android（SFA）、macOS（SFM）、Windows（SFW）。",
      "repo": "SagerNet/sing-box",
      "homepage": "https://sing-box.sagernet.org/",
      "platforms": ["windows", "macos", "android"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0 + 附加条款",
        "redistribution": "allowed",
        "note": "GPL-3.0，并附带“禁止衍生作品使用 sing-box 名称”的附加条款；原样再分发官方安装包不受影响。"
      },
      "mirror": { "enabled": true, "note": "" },
      "exclude": [
        "^sing-box-",
        "legacy-android-5",
        "^SFI-",
        "\\.dSYMs",
        "^SFL-",
        "metadata\\.json$",
        "\\.tar\\.gz$"
      ],
      "rules": [
        {
          "match": "^SFA-[0-9.]+-(?<arch>arm64-v8a|armeabi-v7a|x86_64|universal)\\.apk$",
          "platform": "android",
          "format": "apk",
          "variant": "default",
          "arch": "$arch"
        },
        {
          "match": "^SFM-[0-9.]+-(?<arch>Apple|Intel|Universal)\\.pkg$",
          "platform": "macos",
          "format": "pkg",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^SFW-[0-9.]+-(?<arch>x64|arm64)\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "default",
          "arch": "$arch"
        }
      ],
      "caveats": [
        "sing-box 主程序（sing-box-*.tar.gz、命令行）是核心程序，不是图形客户端，本站不作为客户端展示。",
        "SFA/SFM/SFW 是官方提供的图形界面，覆盖 Android / macOS / Windows。"
      ]
    },
    {
      "id": "hiddify",
      "name": "Hiddify",
      "nameZh": "Hiddify",
      "summary": "sing-box 内核的跨平台客户端，界面向导化，适合新手配置订阅。",
      "repo": "hiddify/hiddify-app",
      "homepage": "https://hiddify.com/",
      "platforms": ["windows", "macos", "android"],
