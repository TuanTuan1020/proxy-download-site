      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接。"
      },
      "mirror": { "enabled": true, "note": "" },
      "exclude": [
        "\\.sig$",
        "\\.sha256$",
        "symbols",
        "AppImage",
        "\\.deb$",
        "\\.rpm$",
        "\\.app\\.tar\\.gz$",
        "updater\\.exe$",
        "fixed-webview_portable"
      ],
      "rules": [
        {
          "match": "^Clash\\.Nyanpasu_[0-9.]+_fixed-webview-(?<arch>x64|arm64)-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "fixed-webview2",
          "arch": "$arch"
        },
        {
          "match": "^Clash\\.Nyanpasu_[0-9.]+_(?<arch>x64|arm64)-setup\\.exe$",
          "platform": "windows",
          "format": "exe",
          "variant": "installer",
          "arch": "$arch"
        },
        {
          "match": "^Clash\\.Nyanpasu_[0-9.]+_(?<arch>x86_64|aarch64)_portable\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "portable",
          "arch": "$arch"
        },
        {
          "match": "^Clash\\.Nyanpasu_[0-9.]+_(?<arch>x64|aarch64)\\.dmg$",
          "platform": "macos",
          "format": "dmg",
          "variant": "installer",
          "arch": "$arch"
        }
      ],
      "caveats": ["开发版（Dev）与稳定版分开发布；本站默认展示稳定版。"]
    },
    {
      "id": "v2rayn",
      "name": "v2rayN",
      "nameZh": "v2rayN",
      "summary": "Windows/macOS 上使用 Xray、sing-box 等内核的图形客户端，含订阅与路由设置。",
      "repo": "2dust/v2rayN",
      "homepage": "https://github.com/2dust/v2rayN",
      "platforms": ["windows", "macos"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接。"
      },
      "mirror": { "enabled": true, "note": "" },
      "exclude": [
        "\\.sig$",
        "public-key",
        "-linux",
        "windows-86",
        "macos-64\\.zip$",
        "macos-arm64\\.zip$"
      ],
      "rules": [
        {
          "match": "^v2rayN-windows-64-desktop\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "desktop",
          "arch": "x64"
        },
        {
          "match": "^v2rayN-windows-64\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "portable",
          "arch": "x64"
        },
        {
          "match": "^v2rayN-windows-arm64-desktop\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "desktop",
          "arch": "arm64"
        },
        {
          "match": "^v2rayN-windows-arm64\\.zip$",
          "platform": "windows",
          "format": "zip",
          "variant": "portable",
          "arch": "arm64"
        },
        {
          "match": "^v2rayN-macos-(?<arch>64|arm64)\\.dmg$",
          "platform": "macos",
          "format": "dmg",
          "variant": "installer",
          "arch": "$arch"
        }
      ],
      "caveats": [
        "Windows 的 -desktop 版本依赖已安装的 .NET 桌面运行时，普通用户选不带 desktop 的压缩包即可。",
        "v2rayN 是图形客户端；Xray、sing-box 等内核不在本站收录范围。"
      ]
    },
    {
      "id": "v2rayng",
      "name": "v2rayNG",
      "nameZh": "v2rayNG",
      "summary": "Android 上使用 Xray 内核的图形客户端，支持订阅、分应用代理。",
      "repo": "2dust/v2rayNG",
      "homepage": "https://github.com/2dust/v2rayNG",
      "platforms": ["android"],
      "kindLabel": "图形客户端（GUI）",
      "status": "active",
      "statusNote": "",
      "license": {
        "spdx": "GPL-3.0",
        "label": "GPL-3.0",
        "redistribution": "allowed",
        "note": "GPL-3.0：允许原样再分发官方安装包，需保留版权声明并提供源码链接。"
