# ==========================================================================
# 代理客户端下载站 —— 环境变量模板
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 全部留空时站点仍可运行：会用 HTML 回退方式采集元数据，
# 下载按钮显示“本站下载暂不可用”，只提供官方入口。
# ==========================================================================

# --------------------------------------------------------------------------
# 1) GitHub 数据采集
# --------------------------------------------------------------------------
# 强烈建议填写。未认证请求每小时仅 60 次，无法支撑每 5~10 分钟检查 11 个项目。
# 只用只读的 public_repo 权限即可（细粒度令牌：Public repositories 只读）。
GITHUB_TOKEN=

# GitHub API 基地址（一般不用改；企业版/GHES 才需要改）
GITHUB_API_BASE=https://api.github.com

# GitHub API 限流时是否允许退回到 github.com 网页/Atom 方式采集元数据
# 回退数据会标记为 dataSource=html-fallback，部分字段（如资产精确字节数）为近似值
ALLOW_HTML_FALLBACK=true

# 每个项目最多保留多少个 Release 供比较（API 分页 per_page）
RELEASES_PAGE_SIZE=10

# --------------------------------------------------------------------------
# 2) 定时任务
# --------------------------------------------------------------------------
# 检查间隔（分钟）。默认 8 分钟，官方目标区间为 5~10 分钟。
CHECK_INTERVAL_MINUTES=8

# 超过多久未成功采集，前端显示“数据可能过期”（分钟）
STALE_AFTER_MINUTES=30

# 单个资产同步的最大体积（MB），超过则跳过并标记，避免误同步大文件
MAX_ASSET_MB=400

# 同时同步的项目数（避免占满带宽/GitHub 并发限制）
MAX_PARALLEL_SYNC=2

# 同步失败后的退避上限（秒）；实际退避按 2^n 递增并加抖动
RETRY_BACKOFF_MAX_SECONDS=900

# --------------------------------------------------------------------------
# 3) 安装包存储
# --------------------------------------------------------------------------
# local = 本机目录（本地演示/自建服务器）；s3 = S3 兼容对象存储（Cloudflare R2 / AWS S3 / B2）
STORAGE_DRIVER=local

# local 驱动：安装包落盘目录
LOCAL_STORAGE_DIR=./storage/files

# s3 驱动
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 对象存储对外访问前缀（CDN 域名或公开桶域名），例如 https://dl.example.com
# 填写后前端“下载安装包”按钮直接指向该前缀；留空则走本站 /download/ 路由
S3_PUBLIC_BASE_URL=

# 本站下载路由前缀（不改则用 /download）；如把下载服务放在独立域名，
# 可填完整地址，例如 https://dl.example.com/download
PUBLIC_DOWNLOAD_BASE=/download

# 旧版本保留策略：默认保留最近 2 个成功同步的稳定版本（清理默认只预览不删除）
RETENTION_KEEP_VERSIONS=2

# --------------------------------------------------------------------------
# 4) 服务与后台管理
# --------------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1

# 手动触发更新接口（POST /api/admin/update）的令牌。留空则后台接口整体关闭。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# 站点展示用名称（可选覆盖 config/site.json）
SITE_NAME=
